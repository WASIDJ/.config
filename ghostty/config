# ============================================
# 字体配置（关键修改）
# ============================================
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 18
font-thicken = true
font-thicken-strength = 255
# 固定中文字体为山海朝凤宋，避免粗体/斜体回退造成中英文字面差异。
font-codepoint-map = U+2E80-U+9FFF,U+F900-U+FAFF,U+FF00-U+FFEF,U+20000-U+323AF=YEFONTShanHaiChaoFengSong
adjust-cell-height = 8%
# 加宽单元格：山海朝凤宋是竖长宋体，默认格子里横向被压缩，加宽缓解
adjust-cell-width = 10%

# ============================================
# 主题与外观
# ============================================
theme = Catppuccin Mocha
window-decoration = false
window-padding-x = 12
window-padding-y = 8
# 整行余量上下对半分，避免全部堆在底部状态栏下面。
window-padding-balance = true
background-opacity = 0.94
background-blur-radius = 18 

# macOS 隐藏标题栏（可选，替代 Linux 的 gtk-titlebar）
macos-titlebar-style = transparent

# 左右 Option 都作为 Alt/Meta；Ghostty 已绑定的快捷键仍优先处理。
macos-option-as-alt = true

# ============================================
# 光标与滚动
# ============================================
cursor-style = block
cursor-style-blink = false
cursor-opacity = 1.0
# Neovide 风格短拖尾；仅在当前聚焦的终端播放动画。
custom-shader = shaders/cursor-shaders/cursor_warp.glsl
custom-shader-animation = true
scrollback-limit = 3023

# ============================================
# 终端特性
# ============================================
mouse-hide-while-typing = true
# Shift 始终由 Ghostty 处理，供 tmux mouse on 时尝试 ⌘+Shift+click。
mouse-shift-capture = never
copy-on-select = false
confirm-close-surface = false
app-notifications = no-clipboard-copy,no-config-reload

# ============================================
# 快捷键（Option+数字交给 tmux；Cmd+数字保留给 Ghostty tab）
# ============================================
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size

# 分屏管理：Option+s/v/z 由 Ghostty 处理，Option+jkil 交给 tmux（j左 k下 i上 l右）。
keybind = alt+v=new_split:right
keybind = alt+s=new_split:down
keybind = alt+z=toggle_split_zoom
keybind = alt+equal=equalize_splits

# 标签页管理
keybind = ctrl+t=new_tab
keybind = ctrl+shift+w=close_tab
keybind = ctrl+shift+left=previous_tab
keybind = ctrl+shift+right=next_tab
# Option+数字 显式发送 ESC+数字，对应 tmux 的 M-0..M-9；Cmd+数字 仍切 Ghostty tab。
# 同时覆盖字符键和物理数字键（digit_N），避免不同键盘布局下漏绑。
# 修改后需重载 Ghostty；tmux 从 1 编号，Option+0 对应第 10 个 window。
keybind = alt+0=esc:0
keybind = alt+1=esc:1
keybind = alt+2=esc:2
keybind = alt+3=esc:3
keybind = alt+4=esc:4
keybind = alt+5=esc:5
keybind = alt+6=esc:6
keybind = alt+7=esc:7
keybind = alt+8=esc:8
keybind = alt+9=esc:9
keybind = alt+digit_0=esc:0
keybind = alt+digit_1=esc:1
keybind = alt+digit_2=esc:2
keybind = alt+digit_3=esc:3
keybind = alt+digit_4=esc:4
keybind = alt+digit_5=esc:5
keybind = alt+digit_6=esc:6
keybind = alt+digit_7=esc:7
keybind = alt+digit_8=esc:8
keybind = alt+digit_9=esc:9

# 窗口管理
keybind = ctrl+shift+n=new_window
keybind = ctrl+shift+j=goto_window:next
keybind = ctrl+shift+k=goto_window:previous

# 复制/粘贴
keybind = ctrl+shift+f=write_scrollback_file:open
keybind = ctrl+alt+f=write_screen_file:open

# 其他
unfocused-split-opacity = 0.7
unfocused-split-fill = #44464f
shell-integration = detect
shell-integration-features = cursor,sudo,title,no-cursor
keybind = shift+enter=text:\n

# 如果你有 dankcolors 配置文件，请修改为绝对路径
# config-file = ~/.config/ghostty/config-dankcolors

# 保留默认 xterm-ghostty，供 tmux 正确识别终端能力。
term = xterm-ghostty
